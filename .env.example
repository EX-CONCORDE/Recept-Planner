# PostgreSQL
DATABASE_URL="postgresql://recept:YOUR_SECURE_PASSWORD@localhost:5432/recept_planner"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Google OAuth（任意。未設定時はCredentials認証のみ）
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Cloudflare Access（任意。cloudflared tunnel経由で公開する場合）
# CF_ACCESS_TEAM="your-team"        # <team>.cloudflareaccess.com のチーム名
# CF_ACCESS_AUD="your-audience-tag" # Application Audience (AUD) Tag

# LMStudio（Vision対応モデルが稼働しているサーバー）
LMSTUDIO_BASE_URL="http://192.168.1.x:1234"
LMSTUDIO_MODEL="gemma-3-12b"

# レシート画像保存先（public外のディレクトリ）
RECEIPT_STORAGE_PATH="./data/receipts"

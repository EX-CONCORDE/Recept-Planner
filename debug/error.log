 source .env
  node -e "
  const pg = require('pg');
  const pool = new pg.Pool({ connectionString: process.env.DATABASE_URL });
  pool.query('DROP INDEX IF EXISTS categories_name_key')
    .then(() => console.log('OK: old unique index dropped'))
    .catch(e => console.error(e))
    .finally(() => pool.end());
  "

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  type      String   @default("expense") @db.VarChar(20) // expense | income
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  transactions  Transaction[]
  subscriptions Subscription[]

  @@map("categories")
}

model Transaction {
  id             Int       @id @default(autoincrement())
  txType         String    @map("tx_type") @db.VarChar(20) // expense | income
  amount         Int       // 日本円（整数）
  txDate         DateTime  @map("tx_date") @db.Date
  categoryId     Int?      @map("category_id")
  merchantName   String?   @map("merchant_name") @db.VarChar(300)
  memo           String?   @db.VarChar(500)
  receiptId      Int?      @map("receipt_id")
  source         String    @default("manual") @db.VarChar(20) // manual | ai | subscription
  subscriptionId Int?      @map("subscription_id")
  billingKey     String?   @unique @map("billing_key") @db.VarChar(100) // subscriptionId:YYYY-MM-DD
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipt      Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([txDate])
  @@index([categoryId])
  @@index([subscriptionId])
  @@map("transactions")
}

model Receipt {
  id           Int      @id @default(autoincrement())
  filePath     String   @map("file_path") @db.VarChar(500)
  ocrRawText   String?  @map("ocr_raw_text")
  aiResultJson Json?    @map("ai_result_json")
  status       String   @default("uploaded") @db.VarChar(20) // uploaded | processed | confirmed | failed
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  transactions Transaction[]

  @@map("receipts")
}

model MonthlyPlan {
  id                 Int      @id @default(autoincrement())
  yearMonth          String   @unique @map("year_month") @db.VarChar(7) // YYYY-MM
  monthlyIncome      Int      @default(0) @map("monthly_income") // 手取り（自動計算 or 手動入力）
  grossIncome        Int?     @map("gross_income") // 額面月収（税計算用）
  age                Int?     // 年齢（介護保険判定用）
  prefecture         String?  @db.VarChar(10) // 都道府県（健保料率用）
  bonusMonths        Float?   @map("bonus_months") // 賞与月数
  autoCalcTax        Boolean  @default(false) @map("auto_calc_tax") // 税金自動計算フラグ
  savingTargetAmount Int      @default(0) @map("saving_target_amount")
  savingTargetRate   Float?   @map("saving_target_rate")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("monthly_plans")
}

model SavingsGoal {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200) // 目標名（例: 旅行資金、緊急資金）
  targetAmount Int     @map("target_amount") // 目標額
  currentAmount Int    @default(0) @map("current_amount") // 手動で調整可能な現在額
  deadline    String?  @db.VarChar(7) // 達成期限 YYYY-MM（任意）
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("savings_goals")
}

model Subscription {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(200)
  amount          Int      // 1回あたりの請求額（日本円）
  billingCycle    String   @map("billing_cycle") @db.VarChar(10) // monthly | yearly
  categoryId      Int?     @map("category_id")
  nextBillingDate DateTime @map("next_billing_date") @db.Date
  isActive        Boolean  @default(true) @map("is_active")
  presetKey       String?  @map("preset_key") @db.VarChar(100)
  icon            String?  @db.VarChar(50)
  color           String?  @db.VarChar(20)
  memo            String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([nextBillingDate])
  @@index([isActive])
  @@map("subscriptions")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

model AssistantMessage {
  id        Int      @id @default(autoincrement())
  role      String   @db.VarChar(20) // user | assistant
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("assistant_messages")
}

model FinancialAdvice {
  id        Int      @id @default(autoincrement())
  yearMonth String   @map("year_month") @db.VarChar(7)
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([yearMonth])
  @@index([createdAt])
  @@map("financial_advice")
}

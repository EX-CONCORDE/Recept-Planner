generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         String   @default("member") @db.VarChar(20) // admin | member
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  accounts     Account[]
  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  receipts     Receipt[]
  monthlyPlans MonthlyPlan[]
  savingsGoals SavingsGoal[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Domain ──────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  type      String   @default("expense") @db.VarChar(20) // expense | income
  isDefault Boolean  @default(false) @map("is_default")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([name, userId])
  @@map("categories")
}

model Transaction {
  id           Int       @id @default(autoincrement())
  txType       String    @map("tx_type") @db.VarChar(20) // expense | income
  amount       Int       // 日本円（整数）
  txDate       DateTime  @map("tx_date") @db.Date
  categoryId   Int?      @map("category_id")
  merchantName String?   @map("merchant_name") @db.VarChar(300)
  memo         String?   @db.VarChar(500)
  receiptId    Int?      @map("receipt_id")
  source       String    @default("manual") @db.VarChar(20) // manual | ai
  userId       Int       @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([txDate])
  @@index([categoryId])
  @@index([userId])
  @@map("transactions")
}

model Receipt {
  id           Int      @id @default(autoincrement())
  filePath     String   @map("file_path") @db.VarChar(500)
  ocrRawText   String?  @map("ocr_raw_text")
  aiResultJson Json?    @map("ai_result_json")
  status       String   @default("uploaded") @db.VarChar(20) // uploaded | processed | confirmed | failed
  userId       Int      @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("receipts")
}

model MonthlyPlan {
  id                 Int      @id @default(autoincrement())
  yearMonth          String   @map("year_month") @db.VarChar(7) // YYYY-MM
  monthlyIncome      Int      @default(0) @map("monthly_income")
  grossIncome        Int?     @map("gross_income")
  age                Int?
  prefecture         String?  @db.VarChar(10)
  bonusMonths        Float?   @map("bonus_months")
  autoCalcTax        Boolean  @default(false) @map("auto_calc_tax")
  savingTargetAmount Int      @default(0) @map("saving_target_amount")
  savingTargetRate   Float?   @map("saving_target_rate")
  userId             Int      @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([yearMonth, userId])
  @@map("monthly_plans")
}

model SavingsGoal {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  targetAmount  Int      @map("target_amount")
  currentAmount Int      @default(0) @map("current_amount")
  deadline      String?  @db.VarChar(7)
  isActive      Boolean  @default(true) @map("is_active")
  userId        Int      @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}
